{
  "name": "vigilante",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Neighborhood situational awareness console (desktop, multi-monitor).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "tsc --noEmit && vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "fflate": "^0.8.3",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^5.24.1",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "undici": "^7.30.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
